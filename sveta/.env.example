# Sveta.Net — muhit o'zgaruvchilari namunasi
# Nusxa oling: cp .env.example .env  va haqiqiy qiymatlarni qo'ying.
# .env fayli git ga TUSHMAYDI (.gitignore).

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
# polling — lokal ishlab chiqish; webhook — prod (ommaviy HTTPS manzil kerak)
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_PATH=/telegram/webhook

# --- Baza ---
DATABASE_URL=postgresql+asyncpg://sveta:sveta@localhost:5432/sveta
DB_POOL_SIZE=10
DB_ECHO=false

# --- Ilova ---
APP_ENV=local
LOG_LEVEL=INFO
# Mintaqa xabar kelganda **nuqtadan** aniqlanadi (E19). Bu qiymat faqat
# mintaqa ko'rsatilmagan o'qish so'rovlari uchun: `/map`, `/stats`, `/heatmap`.
DEFAULT_REGION_CODE=samarkand
# Oxirgi tayanch. Javob tili avval `Accept-Language` dan, keyin
# `regions.default_language` dan olinadi (`01` §16, §17) — bu qiymat
# faqat mintaqa noma'lum bo'lgan joyda ishlaydi. Mintaqaning tilini
# `python -m tools.region_admin update --code <kod> --lang ru` bilan
# o'zgartiring.
DEFAULT_LANGUAGE=uz
# Ommaviy API ning prefiksi. **Amalda o'zgartirilmaydi:** `/api/v1` yo'li
# `web/app.js` (`SVETA_API_BASE` ning zaxirasi), `Dockerfile` ning
# healthcheck i va OpenAPI kontrakt testlarida qattiq yozilgan — bu qiymatni
# o'zgartirish sahifani va healthcheck ni **jimgina** yiqitadi. Shu yerda
# turishining sababi: u `Settings` maydoni, ya'ni muhitdan baribir
# o'qiladi va operatordan yashirilishi kerak emas (PROGRESS.md «Ochiq
# savollar»: sozlama bo'lib qolsinmi yoki konstantaga aylantirilsinmi).
API_PREFIX=/api/v1

# --- Geo ---
H3_RESOLUTION=9
GEOCODER_PROVIDER=
GEOCODER_API_KEY=

# --- Mintaqalar (E19) ---
# Faol mintaqalar ro'yxati keshda saqlanadi. `tools/region_admin.py` bilan
# qo'shilgan mintaqa ko'pi bilan shu vaqtdan keyin o'zi ko'rinadi.
REGION_CACHE_TTL_S=300

# --- Ommaviy chegaralar endpointi (E15, 05 §7.2) ---
# Chegaralar deyarli o'zgarmaydi, shuning uchun kesh xarita snapshotidan uzun
GEO_BOUNDARIES_TTL_S=3600
# `ST_SimplifyPreserveTopology` tolerantligi (m). `0` — soddalashtirishsiz;
# so'rovda `?simplify_m=` bilan bekor qilinadi, chegara — MAX qiymati
GEO_BOUNDARIES_SIMPLIFY_M=25
GEO_BOUNDARIES_MAX_SIMPLIFY_M=500
# GeoJSON koordinatasining xonalar soni (6 ≈ 0.11 m)
GEO_BOUNDARIES_PRECISION=6

# --- Interfeys ---
DISPLAY_TIMEZONE=Asia/Tashkent

# --- Xarita ---
# Bot dagi «🗺 Xarita» tugmasi shu manzilga olib boradi (E9 gacha bo'sh)
MAP_PUBLIC_URL=
# Veb-xarita foni. 👤 ADR-08 (2026-08-11): manba — OpenStreetMap.
# Bo'sh qolsa sahifa fon rasmisiz, faqat uzilish nuqtalari bilan ochiladi
# (`web/README.md`); `scripts/deploy.sh` bo'sh bo'lsa OSM qiymatini yozadi.
# ⚠️ tile.openstreetmap.org — bepul, lekin ommaviy og'ir trafikka
# mo'ljallanmagan (OSM Tile Usage Policy); pilot uchun yetarli, ommaviy
# bosqichda (E12) o'z tayl-serveri yoki pullik provayder ko'rib chiqiladi.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
# Snapshot yangilanish davri. `05` §7.1 (kesh) va §8 (fon vazifasi) —
# bir xil qiymat; test buni qulflaydi.
MAP_SNAPSHOT_TTL_S=60

# --- Klasterlash (05 §4.2, BASELINE-TAS — E11 da sozlanadi) ---
CLUSTER_EPS_M=400
CLUSTER_TIME_WINDOW_MIN=90
CLUSTER_MIN_REPORTERS=3
CLUSTER_AUTOCLOSE_AFTER_MIN=120
CLUSTER_MAX_RADIUS_M=3000

# --- Mustaqil xabar beruvchi (05 §4.3) ---
REPORTER_MIN_TRUST_SCORE=30
REPORTER_MIN_ACCOUNT_AGE_MIN=10
REPORTER_MIN_DISTANCE_M=50

# --- Maxfiylik (05 §3.2, §7.3) ---
EXACT_GEOM_RETENTION_DAYS=90
EXACT_GEOM_PURGE_BATCH=10000
PUBLIC_MIN_REPORTS=3
PUBLIC_TIME_ROUNDING_MIN=5
JITTER_MAX_M=60

# --- Cheklovlar va qamrov ---
REPORT_RATE_LIMIT_MIN=10
COVERAGE_WINDOW_DAYS=30
COVERAGE_MIN_ACTIVE_USERS=5

# --- Soxta geolokatsiya: tezlik tekshiruvi (06 §11) ---
# Birinchi ikkitasi `06` §11 dan aynan («10 daqiqada 5 km»).
# Jazoning kattaligi spetsifikatsiyada yo'q — [GIPOTEZA], E11 da sozlanadi.
VELOCITY_WINDOW_MIN=10
VELOCITY_MAX_DISTANCE_M=5000
VELOCITY_TRUST_PENALTY=10

# --- Obuna va bildirishnoma (E13, 05 §2.4) ---
# Obuna = nuqta + radius. Manzil bo'yicha obuna geokoder tanlangandan
# keyin (ADR-06). Radius pastki chegarasi kodda: 200 m (jitter 60 m gacha).
SUBSCRIPTION_DEFAULT_RADIUS_M=500
SUBSCRIPTION_MAX_RADIUS_M=3000
SUBSCRIPTION_MAX_PER_USER=5
# process_outbox (5 s): bitta yurishdagi hodisalar soni, urinishlar chegarasi
# va kechikish asosi (eksponensial, 1 soatgacha).
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_BACKOFF_S=30

# --- Statistika va Coverage Index (E14, 05 §7.2, 03 §R1.2) ---
# `from`/`to` berilmasa oxirgi N kun; undan uzun davr 422 beradi.
STATS_DEFAULT_PERIOD_DAYS=30
STATS_MAX_PERIOD_DAYS=366
# Bitta so'rovda ko'riladigan hodisalar shifti (kesilsa javobda `truncated`).
STATS_MAX_OUTAGES=5000
# Javobdagi mahallalar shifti (01 §16). Tumanlar o'nlab, mahallalar esa
# minglab — cheksiz ro'yxat statistika javobini bosib ketardi. Kesilsa
# `mahallas.truncated` chiqadi; jimgina kesish taqsimotni yolg'on qilardi.
STATS_MAX_MAHALLAS=2000
# Coverage Index ning `penetration` komponenti: xo'jaliklarning qancha ulushi
# faol xabar beruvchi bo'lishi kutiladi. [GIPOTEZA] — formula validatsiya
# qilinmagan (01 §Glossariy, C-11), qiymat E11 da sozlanadi.
STATS_TARGET_PENETRATION=0.02
# «Yosh mintaqa» dislaymeri (01 FR-S-901, §23). Kuzatuv tarixi shu kundan
# qisqa YOKI tasdiqlangan hodisalar shu sondan kam bo'lsa, vitrina ma'lumot
# chuqurligi yetarli emasligini ochiq aytadi.
# 90 kun — FR-S-901 dagi «≥N oy» ning eng kichik ma'noli o'qilishi,
# [GIPOTEZA], E11 da sozlanadi. 30 esa FR-901 dan meros: ahamiyat chegarasi.
STATS_MIN_HISTORY_DAYS=90
STATS_MIN_EVENTS=30

# --- H3 issiqlik xaritasi (E16, 03 §R1.2) ---
# Bitta javobdagi katakchalar shifti. Kesilsa `truncated` bayrog'i chiqadi;
# kesilgani eng sovuq katakchalar bo'ladi (tartib zichlik bo'yicha kamayadi).
HEATMAP_MAX_CELLS=3000
# `04` E16 chiqish mezoni — «zichlik yetarli bo'lganda». Ko'rinadigan katakcha
# shundan kam bo'lsa javob `sufficient = false` bo'ladi: uch katakchali
# issiqlik xaritasi hududni emas, tasodifni ko'rsatadi. [GIPOTEZA] — E11.
HEATMAP_MIN_CELLS=10
# Zichlik so'ralgan davr bo'yicha hisoblanadi va soatlab o'zgarmaydi,
# shuning uchun kesh `/map` (60 s) dan ancha uzoq.
HEATMAP_TTL_S=900

# --- Admin-panel (E8) ---
# `nom:rol:token` uchliklari, vergul bilan ajratiladi.
# Rollar: viewer (faqat o'qish) | moderator (rad etish, birlashtirish,
# bloklash) | admin (+ trust_score va audit).
# Token — kamida 24 belgi, tasodifiy: `python -c "import secrets;
# print(secrets.token_urlsafe(48))"`. Bo'sh bo'lsa admin endpointlari
# hamma so'rovga 403 beradi.
ADMIN_TOKENS=

# --- Kunlik hisobot (05 §8 daily_digest) ---
# Hisobot yuboriladigan Telegram chat identifikatorlari, vergul bilan
# (odatda moderatorlar guruhi; guruh id si manfiy bo'ladi).
# Bo'sh bo'lsa hisobot yig'iladi va saqlanadi, lekin yuborilmaydi —
# uni `GET /api/v1/admin/digest` orqali o'qish mumkin.
DIGEST_CHAT_IDS=
# Har yurishda ko'riladigan tugagan sutkalar soni (yuboriladigan — faqat kechagi).
DIGEST_BACKFILL_DAYS=3

# --- Kuzatuvchanlik (05 §10) ---
# Oynali metrikalar (geo_unmatched_ratio, time_to_confirm_seconds) shuncha
# soatlik kesimda hisoblanadi.
METRICS_WINDOW_HOURS=24
# 05 §10: ogohlantirish faqat to'rttasiga. Birinchi uchtasining chegarasi
# spetsifikatsiyada yozilgan, to'rtinchisi (xatolik darajasi) yozilmagan.
ALERT_SNAPSHOT_AGE_S=300
ALERT_OUTBOX_LAG_S=120
ALERT_GEO_UNMATCHED_RATIO=0.05
ALERT_ERROR_RATE=0.05
# Shundan kam so'rovda xatolik darajasi hisoblanmaydi (shovqinga qarshi).
ALERT_ERROR_MIN_REQUESTS=100
# `GET /api/v1/metrics` ADMIN_TOKENS bilan himoyalangan: Prometheus scrape
# konfiguratsiyasida `X-Admin-Token` sarlavhasi ko'rsatilishi kerak.

# --- Docker Compose (ixtiyoriy) ---
POSTGRES_USER=sveta
POSTGRES_PASSWORD=sveta
POSTGRES_DB=sveta
POSTGRES_PORT=5432
API_PORT=8000
# Veb-xarita (nginx) porti — `docker-compose.yml` dagi `web` xizmati
WEB_PORT=8080

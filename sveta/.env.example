# Sveta.Net — muhit o'zgaruvchilari namunasi
# Nusxa oling: cp .env.example .env  va haqiqiy qiymatlarni qo'ying.
# .env fayli git ga TUSHMAYDI (.gitignore).

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
# polling — lokal ishlab chiqish; webhook — prod (ommaviy HTTPS manzil kerak)
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_PATH=/telegram/webhook

# --- Baza ---
DATABASE_URL=postgresql+asyncpg://sveta:sveta@localhost:5432/sveta
DB_POOL_SIZE=10
DB_ECHO=false

# --- Ilova ---
APP_ENV=local
LOG_LEVEL=INFO
DEFAULT_REGION_CODE=samarkand
DEFAULT_LANGUAGE=uz

# --- Geo ---
H3_RESOLUTION=9
GEOCODER_PROVIDER=
GEOCODER_API_KEY=

# --- Interfeys ---
DISPLAY_TIMEZONE=Asia/Tashkent

# --- Xarita ---
# Bot dagi «🗺 Xarita» tugmasi shu manzilga olib boradi (E9 gacha bo'sh)
MAP_PUBLIC_URL=
MAP_TILE_URL=
MAP_SNAPSHOT_TTL_S=60

# --- Klasterlash (05 §4.2, BASELINE-TAS — E11 da sozlanadi) ---
CLUSTER_EPS_M=400
CLUSTER_TIME_WINDOW_MIN=90
CLUSTER_MIN_REPORTERS=3
CLUSTER_AUTOCLOSE_AFTER_MIN=120
CLUSTER_MAX_RADIUS_M=3000

# --- Mustaqil xabar beruvchi (05 §4.3) ---
REPORTER_MIN_TRUST_SCORE=30
REPORTER_MIN_ACCOUNT_AGE_MIN=10
REPORTER_MIN_DISTANCE_M=50

# --- Maxfiylik (05 §3.2, §7.3) ---
EXACT_GEOM_RETENTION_DAYS=90
PUBLIC_MIN_REPORTS=3
PUBLIC_TIME_ROUNDING_MIN=5
JITTER_MAX_M=60

# --- Cheklovlar va qamrov ---
REPORT_RATE_LIMIT_MIN=10
COVERAGE_WINDOW_DAYS=30
COVERAGE_MIN_ACTIVE_USERS=5

# --- Admin-panel (E8) ---
# `nom:rol:token` uchliklari, vergul bilan ajratiladi.
# Rollar: viewer (faqat o'qish) | moderator (rad etish, birlashtirish,
# bloklash) | admin (+ trust_score va audit).
# Token — kamida 24 belgi, tasodifiy: `python -c "import secrets;
# print(secrets.token_urlsafe(48))"`. Bo'sh bo'lsa admin endpointlari
# hamma so'rovga 403 beradi.
ADMIN_TOKENS=

# --- Docker Compose (ixtiyoriy) ---
POSTGRES_USER=sveta
POSTGRES_PASSWORD=sveta
POSTGRES_DB=sveta
POSTGRES_PORT=5432
API_PORT=8000
